# Скопируйте в .env и заполните. Этот файл в git не попадает.
#
# Вариант 1 (простой): логин и пароль от аккаунта TOBIZ.
TOBIZ_EMAIL=you@example.com
TOBIZ_PASSWORD=change-me

# Вариант 2 (если аккаунт просит капчу): пустые логин/пароль и готовая сессия.
# Достаточно пары cookie `session` и `email`; положите их в volume с сессией:
#   /data/session/cookies.json  ->  {"session": "...", "email": "..."}
# TOBIZ_EMAIL=
# TOBIZ_PASSWORD=

# --- безопасность ---
# 1 = только чтение: инструменты правки не регистрируются
TOBIZ_READ_ONLY=0
# CSV с project_id, с которыми разрешено работать; пусто = все проекты аккаунта
TOBIZ_ALLOWED_PROJECT_IDS=
# лимит файла изображения, МБ
TOBIZ_MAX_UPLOAD_MB=10

# --- транспорт MCP ---
# stdio (по умолчанию) — так сервер запускают CLI-агенты: docker run -i --rm ...
# http — постоянный сервис на порту: docker run -p 8765:8765 -e MCP_TRANSPORT=http ...
# MCP_TRANSPORT=http
# MCP_HTTP_TOKEN=              # если задан, HTTP требует Authorization: Bearer <токен>

# --- прочее ---
TOBIZ_LOG_LEVEL=INFO
